<Window
    x:Class="DeveloperPresence.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DeveloperPresence.App.ViewModels"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    Title="Deskchirp for Discord">
    <Window.SystemBackdrop>
        <media:MicaBackdrop />
    </Window.SystemBackdrop>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" Padding="28" MaxWidth="720" HorizontalAlignment="Stretch">
            <!-- Header Section -->
            <StackPanel Spacing="6">
                <TextBlock Text="Deskchirp for Discord" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Open Discord and your developer app, then turn on sharing. Deskchirp connects to Discord automatically." TextWrapping="Wrap" />
            </StackPanel>

            <!-- Sharing Section -->
            <StackPanel Spacing="16">
                <ToggleSwitch Header="Share on Discord" AutomationProperties.Name="Share on Discord"
                    IsOn="{x:Bind ViewModel.EnableSharing, Mode=TwoWay}" />
                <ToggleSwitch Header="Pause sharing" AutomationProperties.Name="Pause sharing"
                    IsEnabled="{x:Bind ViewModel.IsPauseEnabled, Mode=OneWay}"
                    IsOn="{x:Bind ViewModel.IsPaused, Mode=TwoWay}" />
            </StackPanel>

            <!-- Discord Preview Section -->
            <Border Padding="20" CornerRadius="8" BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Discord preview" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.OutgoingHeadlineText, Mode=OneWay}"
                        Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.OutgoingStateText, Mode=OneWay}"
                        Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                        Visibility="{x:Bind BoolToVisibility(ViewModel.HasOutgoingState), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.ActivityNoteText, Mode=OneWay}" TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind BoolToVisibility(ViewModel.HasActivityNote), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusRecoveryText, Mode=OneWay}" TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind BoolToVisibility(ViewModel.HasStatusRecovery), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.LastUpdateText, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Visibility="{x:Bind BoolToVisibility(ViewModel.HasLastUpdate), Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- T3 Code Section -->
            <StackPanel Spacing="16">
                <TextBlock Text="T3 Code" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <StackPanel Spacing="4">
                    <ToggleSwitch Header="Show T3 activity" AutomationProperties.Name="Show T3 activity"
                        Visibility="{x:Bind BoolToVisibility(ViewModel.IsT3Connected), Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.ShowT3Activity, Mode=TwoWay}" />
                    <TextBlock Text="Show the busiest agent tool and its task and helper counts. A helper is an extra agent working on part of a task. Each T3 thread counts as a task."
                        TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Status:" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.T3StatusText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.T3StatusDetail, Mode=OneWay}" TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Content="{x:Bind ViewModel.T3ConnectButtonText, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ConnectT3Command}"
                        AutomationProperties.Name="{x:Bind ViewModel.T3ConnectButtonAutomationName, Mode=OneWay}" />
                    <TextBlock Text="Opens your browser so you can approve read-only access in T3 Code. Deskchirp only reads which agent tools are working and how many tasks and helpers they have."
                        TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind BoolToVisibility(ViewModel.ShowT3Consent), Mode=OneWay}" />
                    <TextBlock Text="Your sign-in is saved in Windows Credential Manager."
                        TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind BoolToVisibility(ViewModel.IsT3Connected), Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <!-- Linked computers -->
            <Expander Header="Computers" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                IsEnabled="{x:Bind ViewModel.CanChangeComputerLink, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Follow me" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="Share from the computer you most recently used. Other linked computers wait. Switching waits briefly for the previous computer to stop. Activity hides after five minutes without input."
                        TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.ComputerStatus, Mode=OneWay}" TextWrapping="Wrap"
                        AutomationProperties.LiveSetting="Polite" />
                    <HyperlinkButton Content="How to link your computers" Padding="0"
                        NavigateUri="https://github.com/geekynasir/deskchirp-discord/blob/main/docs/computers.md" />
                    <StackPanel Spacing="8" Visibility="{x:Bind BoolToVisibility(ViewModel.ShowComputerLinkForm), Mode=OneWay}">
                        <TextBox Header="Linking address" AutomationProperties.Name="Linking address"
                            Text="{x:Bind ViewModel.LinkingAddress, Mode=TwoWay}" PlaceholderText="Paste your linking address" />
                        <TextBox Header="Computer name" AutomationProperties.Name="Computer name"
                            Text="{x:Bind ViewModel.ComputerName, Mode=TwoWay}" MaxLength="48" />
                        <PasswordBox Header="Linking code" AutomationProperties.Name="Linking code" MaxLength="32"
                            PasswordChanged="OnLinkingCodeChanged" />
                        <TextBlock Text="Use a new code from a linked computer. For your first computer, get a code from your linking service. Use the same Discord account on every computer."
                            TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Content="Link this computer" Command="{x:Bind ViewModel.LinkComputerCommand}" />
                    </StackPanel>
                    <Button Content="Link another computer" Command="{x:Bind ViewModel.CreateComputerCodeCommand}"
                        Visibility="{x:Bind BoolToVisibility(ViewModel.HasComputerLink), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.ComputerPairingCode, Mode=OneWay}" IsTextSelectionEnabled="True"
                        Visibility="{x:Bind BoolToVisibility(ViewModel.HasComputerPairingCode), Mode=OneWay}" />
                    <TextBlock Text="Use once within five minutes. Keep this code private." TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind BoolToVisibility(ViewModel.HasComputerPairingCode), Mode=OneWay}" />
                    <Button Content="Unlink this computer" Command="{x:Bind ViewModel.UnlinkComputerCommand}"
                        Visibility="{x:Bind BoolToVisibility(ViewModel.ShowUnlinkComputer), Mode=OneWay}" />
                    <TextBlock Text="Your linking service sees computer names and recent-use timing. Your app activity stays on your computers. Pause sharing affects this computer only. Unlinking turns sharing off here."
                        TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Expander>

            <Expander Header="Advanced" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                    <TextBox Header="T3 address" AutomationProperties.Name="T3 address"
                        Text="{x:Bind ViewModel.T3Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Paste from T3 Code" IsEnabled="{x:Bind ViewModel.IsT3AddressEditable, Mode=OneWay}" />
                    <TextBlock Text="In T3 Code, open Settings → Environments and choose Copy MCP URL."
                        TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                    <TextBlock Text="Leave the T3 address empty to find the local app. Enter an address only for a remote or custom installation."
                        TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBox Header="Discord application ID" AutomationProperties.Name="Discord application ID"
                        Text="{x:Bind ViewModel.DiscordClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Deskchirp’s application ID is included. Change this only to use your own Discord application."
                        TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Application IDs are 15 to 20 digits. Check that you copied the whole number."
                        TextWrapping="Wrap" Visibility="{x:Bind BoolToVisibility(ViewModel.ShowClientIdError), Mode=OneWay}" />
                    <ToggleSwitch Header="Show app icons" AutomationProperties.Name="Show app icons"
                        IsOn="{x:Bind ViewModel.ShowAppIcons, Mode=TwoWay}" />
                    <TextBlock Text="Optional artwork. Keep this off unless the icons have been added to the Discord application."
                        TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <HyperlinkButton Content="How to add the icons" Padding="0"
                        NavigateUri="https://github.com/geekynasir/deskchirp-discord/blob/main/docs/connect-t3.md#add-logos" />
                </StackPanel>
            </Expander>

            <!-- App Detection Section -->
            <Expander Header="App detection" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12">
                    <TextBlock Text="If T3 Code, Claude, or Codex isn’t recognized, add its version here."
                        TextWrapping="Wrap" />
                    <TextBox Header="Program file" AutomationProperties.Name="Program file"
                        Text="{x:Bind ViewModel.NewExecutableName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="example.exe" />
                    <TextBlock Text="The .exe name shown in Task Manager under Details." TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox Header="Recognize as" AutomationProperties.Name="Recognize as" HorizontalAlignment="Stretch"
                        SelectedIndex="{x:Bind ViewModel.SelectedAppIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="T3 Code" />
                        <ComboBoxItem Content="Claude Desktop" />
                        <ComboBoxItem Content="Codex Desktop" />
                    </ComboBox>
                    <Button Content="Add app" Command="{x:Bind ViewModel.AddMappingCommand}" />
                    <ListView ItemsSource="{x:Bind ViewModel.ProcessMappings}" SelectionMode="None" MaxHeight="220">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProcessMappingItem">
                                <Grid ColumnSpacing="12" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind ExecutableName, Mode=OneWay}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Remove" Click="OnRemoveMappingClicked"
                                        AutomationProperties.Name="{x:Bind RemoveAutomationName, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Expander>

            <!-- Troubleshooting Section -->
            <Expander Header="Troubleshooting" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="10">
                    <TextBlock Text="Active app" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ForegroundAppText, Mode=OneWay}" />
                    <TextBlock Text="Discord connection" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ConnectionStatusText, Mode=OneWay}" />
                </StackPanel>
            </Expander>

            <!-- Privacy Footer -->
            <TextBlock Text="{x:Bind ViewModel.PrivacyFooterText, Mode=OneWay}"
                TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Window>
